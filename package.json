{
  "name": "byakugan-cli",
  "version": "0.1.0",
  "description": "Build the graph of code your TypeScript/React/Next.js app actually uses, down to single exports inside barrels and npm packages, and use it for precise change detection in CI",
  "keywords": [
    "change detection",
    "affected",
    "ci",
    "monorepo",
    "module graph",
    "barrel",
    "tree shaking",
    "nextjs",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "author": "IShotTheSheriff",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IShotTheSheriff/byakugan.git"
  },
  "homepage": "https://github.com/IShotTheSheriff/byakugan#readme",
  "bugs": "https://github.com/IShotTheSheriff/byakugan/issues",
  "type": "module",
  "bin": {
    "byakugan": "bin/byakugan.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "byakugan": "node src/cli.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "oxc-parser": "0.157.0",
    "oxc-resolver": "11.24.2",
    "picomatch": "^4.0.7",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.4",
    "@tailwindcss/oxide": "^4.3.4",
    "@types/node": "^24.10.1",
    "@types/picomatch": "^4.0.2",
    "tailwindcss": "^4.3.4",
    "tailwindcss3": "npm:tailwindcss@^3.4.17",
    "typescript": "7.0.2"
  }
}
