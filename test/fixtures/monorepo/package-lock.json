{
  "name": "acme",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "acme",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/web": {
      "name": "web",
      "dependencies": {
        "@acme/ui": "*",
        "lodash": "4.17.21",
        "next": "15.0.0",
        "react": "19.0.0"
      }
    },
    "packages/ui": {
      "name": "@acme/ui",
      "version": "0.0.0"
    },
    "node_modules/@acme/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "node_modules/left-pad": {
      "version": "1.3.0",
      "resolved": "https://registry.npmjs.org/left-pad/-/left-pad-1.3.0.tgz"
    },
    "node_modules/lodash": {
      "version": "4.17.21",
      "resolved": "https://registry.npmjs.org/lodash/-/lodash-4.17.21.tgz"
    },
    "node_modules/next": {
      "version": "15.0.0",
      "resolved": "https://registry.npmjs.org/next/-/next-15.0.0.tgz"
    },
    "node_modules/react": {
      "version": "19.0.0",
      "resolved": "https://registry.npmjs.org/react/-/react-19.0.0.tgz"
    }
  }
}
